{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AEIG Observatory Experiment Manifest",
  "type": "object",
  "required": ["experiment_id", "title", "status", "domains", "question", "hypotheses", "environment", "captures"],
  "properties": {
    "experiment_id": {"type": "string", "pattern": "^EXP-[A-Z0-9]+-[0-9]{3}$"},
    "title": {"type": "string"},
    "status": {"enum": ["planned", "runnable", "observed", "replicated"]},
    "domains": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "question": {"type": "string"},
    "source_note": {"type": "string"},
    "environment": {
      "type": "object",
      "required": ["ae_version"],
      "properties": {
        "ae_version": {"type": "string"},
        "os": {"type": "string"},
        "hardware": {"type": "string"},
        "gpu": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "hypotheses": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prediction"],
        "properties": {
          "id": {"type": "string"},
          "prediction": {"type": "string"},
          "falsified_by": {"type": "string"}
        }
      }
    },
    "factors": {"type": "array", "items": {"type": "string"}},
    "captures": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "procedure": {"type": "array", "items": {"type": "string"}},
    "result": {
      "type": ["object", "null"],
      "properties": {
        "conclusion": {"type": "string"},
        "surviving_hypotheses": {"type": "array", "items": {"type": "string"}},
        "raw_outputs": {"type": "array", "items": {"type": "string"}},
        "hashes": {"type": "object", "additionalProperties": {"type": "string"}},
        "notes": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}
